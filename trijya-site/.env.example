# ----- Trijya Environment Variables -----
# Copy this file to .env and fill in your values.

# Form endpoint — use Web3Forms (https://web3forms.com) or Formspree (https://formspree.io)
# Web3Forms example: VITE_FORM_ENDPOINT=https://api.web3forms.com/submit
# Formspree example: VITE_FORM_ENDPOINT=https://formspree.io/f/YOUR_FORM_ID
VITE_FORM_ENDPOINT=

# Web3Forms access key (only needed if using Web3Forms)
VITE_WEB3FORMS_KEY=

# Base path for GitHub Pages deployment (e.g. /repo-name/)
# Leave empty or "/" for Vercel / Netlify / Cloudflare Pages
VITE_BASE=/
